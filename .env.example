# =============================================================================
# CIAR Cars — Environment Configuration
# Copy to .env and adjust values
# =============================================================================

# --- Database (SQLite dev / PostgreSQL production) ---
# SQLite (default development):
DATABASE_URL="file:./db/custom.db"

# PostgreSQL (production — uncomment and set provider in schema.prisma):
# DATABASE_URL="postgresql://user:password@localhost:5432/ciar_cars?schema=public"

# --- NextAuth ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-to-a-long-random-string-in-production"

# --- Python Analytics API (optional sidecar) ---
# Local dev:
ANALYTICS_API_URL="http://localhost:8001"
# Vercel (auto-detected if unset — uses https://<domain>/_/analytics-api):
# ANALYTICS_API_URL="https://your-domain.vercel.app/_/analytics-api"
INTERNAL_API_KEY="ciar-dev-internal-key"
CIAR_DATABASE_PATH="./db/custom.db"
ANALYTICS_CORS_ORIGINS="http://localhost:3000"

# --- Vercel production (required) ---
# NEXTAUTH_URL="https://your-domain.vercel.app"
# NEXTAUTH_SECRET="generate-a-long-random-string"
# DATABASE_URL="file:./db/custom.db"

# --- Upload limits ---
MAX_UPLOAD_SIZE_MB=5

# --- Local AI (Ollama) — experimental ---
# Install: https://ollama.com then: ollama pull qwen2.5:7b
OLLAMA_ENABLED="true"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen2.5:7b"
OLLAMA_TIMEOUT_MS=60000
AI_RATE_LIMIT_PER_MIN=20
AI_MAX_CONTEXT_CARS=12
AI_BOT_USER_ID="ai-bot-ciar"
